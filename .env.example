# =============================================================================
# Contoh konfigurasi. Salin jadi .env.local untuk pengembangan lokal.
# JANGAN pernah mengisi berkas ini dengan nilai asli — berkas ini ter-commit.
# Nilai asli diserahkan ke panitia lewat kanal privat (ketentuan teknis no. 11).
# =============================================================================

# -----------------------------------------------------------------------------
# Basis data
# -----------------------------------------------------------------------------
# Sumber koneksi dipilih, bukan digandakan (lib/trust/db.ts):
#   DATABASE_URL terisi -> pool sendiri. Pengembangan lokal, Docker, dan suite
#                          tests/rejection, yang menembak Postgres biasa.
#   DATABASE_URL kosong -> delegasi ke lib/db, pool yang sama persis dengan
#                          jalur baca, lewat Cloud SQL Connector dan DB_*.
#
# Di deployment BIARKAN KOSONG: perintah `gcloud run deploy` mengirim
# CLOUD_SQL_CONNECTION_NAME dan DB_*, bukan DATABASE_URL.
DATABASE_URL="postgres://postgres:rahasia@localhost:5432/ifest_db"

# Peran koneksi WAJIB bukan superuser di deployment.
# Seluruh penegakan append-only pada audit_event, provenance_check, dan
# observation bersandar pada Row Level Security, dan RLS tidak berlaku untuk
# superuser maupun peran ber-BYPASSRLS.
#
# Sudah diperiksa langsung di Cloud SQL: pengguna yang dibuat lewat Cloud SQL
# (mis. ifest_app) TIDAK membawa BYPASSRLS, begitu pula cloudsqlsuperuser yang
# diwarisinya, jadi append-only tetap berlaku di sana tanpa peran tambahan.
# Untuk Postgres biasa yang dijalankan sendiri, buat peran terpisah:
#   scripts/setup_db.sh --init-role   (butuh APP_RW_PASSWORD)

# Dipakai Product/Verification untuk jalur Cloud SQL. Dibiarkan sebagai rujukan
# mereka; komponen Trust tidak membacanya sama sekali.
CLOUD_SQL_CONNECTION_NAME=
DB_NAME=
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesi kontributor
# -----------------------------------------------------------------------------
# WAJIB, minimal 32 karakter. lib/trust/session.ts melempar galat kalau kosong
# atau terlalu pendek, sehingga E7 mati dan seluruh alur kontribusi ikut mati.
# Dipakai menandatangani cookie sesi anonim (HMAC-SHA256).
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Penyimpanan bukti
# -----------------------------------------------------------------------------
# Driver penyimpanan objek bukti. Kedua driver mengembalikan bentuk
# storage_path yang identik: evidence/<place_id>/<hash>.jpg
STORAGE_DRIVER="local"   # opsi: local, gcs

# Mode local saja. Direktori akar di mesin/kontainer. Default: .storage
STORAGE_LOCAL_ROOT=

# Mode gcs saja. Objek asli TIDAK pernah dijadikan publik — yang tayang ke
# pengguna adalah turunan hasil blur wajah, lewat kolom evidence.public_path.
#
# Satu nama, tanpa alias: dipakai lib/trust/storage.ts, README.md, dan
# perintah `gcloud run deploy --set-env-vars`.
GCS_BUCKET=""
GOOGLE_APPLICATION_CREDENTIALS=""

# -----------------------------------------------------------------------------
# Reset batas laju untuk latihan demo
# -----------------------------------------------------------------------------
# Membuka POST /api/contributions/reset-rate-limit.
#
# BIARKAN KOSONG kecuali sedang latihan demo. Tanpa nilai, rutenya membalas 404
# dan keberadaannya tidak terumumkan sama sekali. Endpoint reset yang terbuka
# membuat C1 jadi hiasan: siapa pun tinggal memanggilnya lalu melanjutkan, tepat
# di depan juri yang sedang mencoba menembus pembatas laju.
#
# Resetnya TIDAK menghapus apa pun. Satu audit_event bertindakan
# rate_limit_reset ditulis, dan C1 menghitung sejak reset terakhir itu. Jejaknya
# permanen dan terbaca publik — itu memang maksudnya (Briefing §3).
DEMO_RESET_TOKEN=

# -----------------------------------------------------------------------------
# Model multimodal (Verification engineer)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
VERTEX_LOCATION=
VERTEX_MODEL=
VERTEX_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# Ambang provenans — docs/00-KONTRAK.md §7
# Semuanya punya nilai bawaan di lib/trust/config.ts. Isi hanya kalau memang
# mau menyimpang dari nilai kontrak, dan catat penyimpangannya di PERUBAHAN.md.
# -----------------------------------------------------------------------------
# RATE_LIMIT_PER_HOUR=10
# SKEW_MAX_BEHIND_S=180
# SKEW_MAX_AHEAD_S=60
# GEO_BASE_RADIUS_M=75
# GEO_FAIL_RADIUS_M=120
# GEO_MAX_ACCURACY_M=150
# GEO_MAX_FIX_AGE_S=60
# PHASH_IDENTICAL_MAX=2
# PHASH_SIMILAR_MAX=6
# CAPTURE_TOKEN_TTL_S=600
# UPLOAD_MAX_BYTES=5242880
