# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: .env dan semua turunannya; hanya .env.example (nama variabel saja) yang di-commit
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arahan agent AI dari create-next-app / next dev (tidak di-commit)
/AGENTS.md

# Dokumen kerja tim: spek docs-00 sampai 40, PRODUCT.md, DESIGN.md, draf
# PERUBAHAN, PROGRESS.md, briefing. Disimpan di docs/ dan dibagikan di luar
# repo (tidak di-commit). Yang tetap di root dan di-commit: README.md,
# PERUBAHAN.md (dinilai), CLAUDE.md (dibaca otomatis asisten koding).
/docs/*
!/docs/.gitkeep

# Keluaran alat desain (sidecar DESIGN.md, halaman keputusan)
/.impeccable/

# agent
.claude/

# foto uji mentah dari lapangan (foto nyata, tidak di-commit)
/layak/
/kurang_layak/
/tidak_layak/
/layak_baru/
/kurang_layak_baru/
/tidak_layak_baru/

# instruksi asisten koding (lokal, tidak di-commit)
CLAUDE.md
